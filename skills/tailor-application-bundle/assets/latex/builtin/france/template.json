{
  "schema_version": 1,
  "id": "france",
  "display_name": "French Two-Column CV",
  "description": "A4 sidebar CV preserving the downloaded main.tex and cv.cls visual format.",
  "engine": "xelatex",
  "main": "main.tex.tmpl",
  "required_packages": [
    "fontspec.sty",
    "titlesec.sty",
    "hyperref.sty",
    "fontawesome5.sty",
    "mfirstuc.sty",
    "parskip.sty",
    "geometry.sty",
    "xcolor.sty",
    "tikz.sty",
    "adjustbox.sty",
    "graphicx.sty",
    "enumitem.sty"
  ],
  "required_fonts": [],
  "fragments": {
    "section": ".jaa/section.tex.tmpl",
    "highlight": ".jaa/highlight.tex.tmpl",
    "experience": ".jaa/experience.tex.tmpl",
    "education": ".jaa/education.tex.tmpl",
    "normal": ".jaa/normal.tex.tmpl",
    "one_line": ".jaa/one-line.tex.tmpl",
    "publication": ".jaa/publication.tex.tmpl",
    "bullet": ".jaa/bullet.tex.tmpl",
    "numbered": ".jaa/numbered.tex.tmpl",
    "reversed_numbered": ".jaa/reversed-numbered.tex.tmpl",
    "text": ".jaa/text.tex.tmpl"
  }
}
